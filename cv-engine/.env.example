# CV Engine environment config
# Copy ke .env dan sesuaikan

# === Model ===
# Base model (default):
YOLO_MODEL_NAME=yolov8n.pt

# Setelah fine-tuning selesai, ganti ke:
# YOLO_MODEL_NAME=../models/training/semar_crowd_v1/weights/best.pt

# === Inference Parameters ===
# Untuk base model yolov8n.pt (conservative):
YOLO_IMGSZ=416
YOLO_CONF=0.40
YOLO_IOU=0.45
YOLO_MAX_DET=300

# Untuk model fine-tuned (lebih agresif):
# YOLO_IMGSZ=640
# YOLO_CONF=0.25
# YOLO_IOU=0.35
# YOLO_MAX_DET=500

# === Stream Settings ===
CV_FRAME_INTERVAL=5
MAX_CONCURRENT_STREAMS=2
ROTATION_INTERVAL=60
